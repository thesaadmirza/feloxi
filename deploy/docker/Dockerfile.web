# ── Stage 1: Build ───────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app
RUN corepack enable

# Install dependencies (cached layer)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile

# Next.js standalone bakes API_URL into the routes manifest at build time.
# The runtime entrypoint patches the manifest from the value below
# to whatever API_URL is set in the container's environment.
COPY apps/web/ apps/web/
ARG API_URL=http://api:8080
ENV API_URL=${API_URL}
RUN pnpm --filter web build && printf '%s' "$API_URL" > /tmp/.api-url

# ── Stage 2: Runtime ─────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Only node is needed at runtime. npm, corepack and yarn go, along with the
# dependency trees scanners flag in them.
RUN apk upgrade --no-cache && \
    rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
           /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
           /usr/local/bin/yarn /usr/local/bin/yarnpkg /opt/yarn-* && \
    addgroup --system --gid 1001 feloxi && \
    adduser --system --uid 1001 feloxi

# Next.js standalone output in a monorepo preserves the full directory tree:
#   .next/standalone/apps/web/server.js  (entry point)
#   .next/standalone/node_modules/       (pruned dependencies)
COPY --from=builder --chown=feloxi:feloxi /app/apps/web/.next/standalone ./
COPY --from=builder --chown=feloxi:feloxi /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=feloxi:feloxi /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=feloxi:feloxi /tmp/.api-url ./.api-url
COPY --chown=feloxi:feloxi deploy/docker/web-entrypoint.mjs ./entrypoint.mjs

USER feloxi
EXPOSE 3000
ENV HOSTNAME="0.0.0.0"
ENTRYPOINT ["node", "entrypoint.mjs"]
